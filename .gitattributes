* text=auto
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.cs text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.exe binary
*.obj binary
# Keep the checked application snapshot byte-for-byte across Windows/Linux checkouts.
app/** -text

# Preserve original CRLF bytes while checking application whitespace.
app/** whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
